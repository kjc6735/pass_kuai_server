# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올리지 않아요.
PORT=3000
NODE_ENV=development

# 로그인 액세스 토큰 서명 키. 운영에서는 반드시 길고 무작위인 값 (예: openssl rand -hex 32)
JWT_SECRET=

# 카카오 디벨로퍼스 > 앱 설정 > 앱 키 화면의 앱 ID(숫자). 다른 앱에서 받은 토큰을 막는 데 씀
KAKAO_APP_ID=
# Google 로그인 OAuth 클라이언트 ID(iOS·Android·웹). 여러 개면 쉼표로
GOOGLE_CLIENT_IDS=
# Apple 로그인. CLIENT_ID는 앱 번들 ID, 키는 Apple Developer > Keys에서 받은 .p8 내용(줄바꿈은 \n)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

DATABASE_URL=postgresql://passkuai:passkuai@localhost:15432/passkuai

# AI (문장 분석)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://localhost:8080   # 가짜 AI 서버로 바꿀 때만
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_TIMEOUT_MS=60000

# 음성 인식
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8080/v1   # 가짜 AI 서버로 바꿀 때만
OPENAI_MAX_RETRIES=1
OPENAI_TIMEOUT_MS=15000

# 한도 (0이면 끔)
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_LIMIT=200
DAILY_AUDIO_SECONDS_LIMIT=600
DAILY_BUDGET_USD=2

# 프록시(로드밸런서) 뒤에서 돌릴 때 1로. 실제 접속 IP로 소셜 로그인 횟수를 제한하려면 필요해요.
# TRUST_PROXY=1   # 서버 앞 프록시 개수. Nginx 하나면 1 (deploy/docker-compose.yml은 이미 1)

# 약관 웹 주소. 동의 화면의 전문 보기 링크로 GET /me/agreements에 내려가요. 비우면 null
TERMS_URL=
PRIVACY_URL=
